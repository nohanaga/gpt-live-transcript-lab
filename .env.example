# Existing Azure deployment: sign in with Azure CLI, no API key required.
LIVE_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-live-1
# Backend model deployment on the same Azure resource (independent of the Live deployment).
AZURE_OPENAI_BACKEND_DEPLOYMENT=gpt-6-luna
# LIVE_RESPONSES_MODEL=gpt-6-luna
# Optional Jev decision mode (select in the UI; alternative to model function calling via the Azure OpenAI Responses API).
# Ledger conversation and predefined choices are sent to TypeSafe only in Jev mode.
# TYPESAFE_API_KEY=replace-with-your-typesafe-key
TYPESAFE_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.75
# Optional alternative to Azure CLI:
# AZURE_OPENAI_API_KEY=replace-with-your-resource-key

# Direct OpenAI alternative (explicitly switch provider):
# LIVE_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-openai-project-key
